generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PRIVATE
  PUBLIC
  PERMISSIONED
  UNLISTED
}

enum PackAccessMode {
  OPEN
  PROTECTED
}

enum PackMonetizationType {
  FREE
  DONATION
  ONE_TIME_PURCHASE
  METERED_ROYALTIES
  SPONSORED
  BOUNTY
}

enum CouponType {
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
}

enum CouponRedeemptionType {
  DIRECT_REDEEM
  CHECKOUT
}

enum CouponStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  DISABLED
}

enum PaymentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTICALLY_REFUNDED
}

enum PaymentPurpose {
  SUBSCRIPTION
  PREPAID_WALLET_TOPUP
  PACK_PURCHASE
  PACK_DONATION
  SPONSORSHIP_DEPOSIT
  BOUNTY_ESCROW
}

enum BillingInterval {
  MONTHLY
  ANNUALLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
  TRIALING
}

enum Currency {
  USD
  NPR
  EUR
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  ESEWA
  MANUAL
  MARKETPLACE_CREDITS
}

enum OrgRole {
  OWNER
  ADMIN
  BILLING
  DEVELOPER
}

enum PayoutSourceType {
  CITATION_ROYALTY
  MAINTAINER_SHARE
  PACK_SALE
  DONATION
  BOUNTY_REWARD
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum BountyStatus {
  DRAFT
  OPEN
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum BountySubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  CHANGES_REQUIRED
}

enum AppMemoryOperation {
  READ
  WRITE
  SEARCH
  UPDATE
  DELETE
}

enum AreaKind {
  PERSONAL
  PROJECTS
  SKILLS
  RESEARCH
  LIBRARY
  CUSTOM
}

enum EntryType {
  MEMORY
  NOTE
  REFERENCE
  CODE
  DOCUMENT
  SKILL
  WORKFLOW
  DECISION
  PROMPT
  CUSTOM
}

enum EntryState {
  SUGGESTED
  CONFIRMED
  REJECTED
  ARCHIVED // decay
}

enum RecallPolicy {
  AUTOMATIC
  WHEN_RELEVANT
  MANUAL
  EXCLUDED
}

enum EntryOrigin {
  USER
  APP
  COMMUNITY
  IMPORTED
  CONNECTED_SOURCE
  RECALL
}

enum SyncMode {
  MANUAL
  REVIEW
  SCHEDULED
  CONTINUOUS
}

enum AccessPermission {
  READ
  SUGGEST
  WRITE
}

enum AccessEffect {
  ALLOW
  DENY
}

enum AccessResourceType {
  AREA
  COLLECTION
  ENTRY
  APP_MEMORY
  PACK
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  CANCELLED
}

enum ContextRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  DENIED
  FAILED
}

enum RevisionOperation {
  CREATE
  UPDATE
  DELETE
  MOVE
}

enum CombineStatus {
  PENDING
  COMBINED
  CONFLICTED
  ABORTED
}

enum ConflictResolution {
  KEEP_TARGET
  USE_SOURCE
  CUSTOM
  UNRESOLVED
}

model User {
  id                            String                @id
  name                          String
  username                      String?               @unique
  bio                           String?               @db.Text
  email                         String
  emailVerified                 Boolean               @default(false)
  image                         String?
  stripeConnectId               String?               @unique
  computeQuotaBalanceCents      Float                 @default(600.0) // Ring: 600, Ring+: 2500, Magic Ring: 4500
  marketplaceCreditBalanceCents Float                 @default(0.0) // Ring: 0.0, Ring+: 300, Magic Ring: 1000
  prepaidWalletBalanceCents     Float                 @default(0.0)
  currentMonthSpendCents        Float                 @default(0.0) // P = max(1, currentMonthSpendCents / 100)
  currentBillingCycleStart      DateTime              @default(now())
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  sessions                      Session[]
  accounts                      Account[]
  developedApps                 OauthClient[]         @relation("DeveloperApps")
  oauthrefreshtokens            OauthRefreshToken[]
  oauthaccesstokens             OauthAccessToken[]
  oauthconsents                 OauthConsent[]
  payments                      Payment[]
  couponUsages                  CouponUsage[]
  subscriptions                 Subscription[]
  billingProfiles               BillingProfile[]
  collections                   Collection[]
  entries                       Entry[]               @relation("UserEntries")
  areas                         Area[]
  appMemories                   AppMemory[]
  organizationMembers           OrganizationMember[]
  entries                       Entry[]
  appMemories                   AppMemory[]
  userRoyalties                 UserRoyalty[]
  packs                         Pack[]
  tuneApps                      TuneApp[]
  tuneAppInstallations          TuneAppInstallation[]
  recallBlocks                  RecallBlock[]

  @@unique([email])
  @@map("user")
}

model Organization {
  id                         String               @id @default(cuid())
  name                       String
  slug                       String               @unique
  billingEmail               String?
  computeQuotaBalanceCents   Float                @default(600.0) // Ring: 600, Ring+: 2500, Magic Ring: 4500
  prepaidWalletBalanceCents  Float                @default(0.0)
  currentMonthSpendCents     Float                @default(0.0) // P = max(1, currentMonthSpendCents / 100)
  currentBillingCycleStart   DateTime             @default(now())
  autoRechargeEnabled        Boolean              @default(false)
  autoRechargeThresholdCents Float                @default(1000.0)
  autoRechargeAmountCents    Float                @default(5000.0)
  members                    OrganizationMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(DEVELOPER)
  joinedAt       DateTime     @default(now())

  @@map("organization_members")
}

model Session {
  id                 String              @id
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  developer                        User?                 @relation("DeveloperApps", fields: [userId], references: [id], onDelete: SetNull)
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  appMemories     AppMemory[]
  accessGrants    AccessGrant[]
  contextRequests ContextRequest[]
  apiUsageLedgers ApiUsageLedger[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

model Area {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         AreaKind
  position     Int           @default(0)
  collections  Collection[]
  accessGrants AccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, position])
  @@map("areas")
}

model Collection {
  id          String     @id @default(cuid())
  name        String
  slug        String
  description String?
  visibility  Visibility @default(PRIVATE)
  version     Int        @default(1)
  entryCount  Int        @default(0) // Cached N for O(1)

  userId                 String
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId                 String?
  area                   Area?        @relation(fields: [areaId], references: [id], onDelete: Cascade)
  parentId               String?
  parent                 Collection?  @relation("CollectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children               Collection[] @relation("CollectionTree")
  isVirtualMount         Boolean      @default(false) // True if PROTECTED
  syncMode               SyncMode     @default(MANUAL)
  copiedFromCollectionId String?
  copiedFrom             Collection?  @relation("CollectionCopies", fields: [copiedFromCollectionId], references: [id], onDelete: SetNull)
  copies                 Collection[] @relation("CollectionCopies")
  sourceReleaseId        String?
  sourceRelease          Release?     @relation("ReleaseImportedCollections", fields: [sourceReleaseId], references: [id], onDelete: SetNull)

  entries        Entry[]
  paths          Path[]
  accessGrants   AccessGrant[]
  packImports    PackImport[]
  publishedPacks Pack[]        @relation("PackSourceCollection")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  release   Release? @relation(fields: [releaseId], references: [id])
  releaseId String?

  @@index([userId, slug])
  @@index([userId])
  @@index([areaId, parentId])
  @@map("collection")
}

model Entry {
  id      String    @id @default(cuid())
  title   String
  slug    String?
  content String    @db.Text
  type    EntryType
  version Int       @default(1)

  tags            String[]     @default([])
  state           EntryState   @default(SUGGESTED)
  recallPolicy    RecallPolicy @default(WHEN_RELEVANT)
  origin          EntryOrigin  @default(USER)
  confidenceScore Float        @default(1.0)

  expiresAt  DateTime? // Temporal obsolescence
  archivedAt DateTime?
  metadata   Json?

  embedding Unsupported("vector")?

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  appMemoryId  String?
  appMemory    AppMemory? @relation(fields: [appMemoryId], references: [id], onDelete: Cascade)

  userId   String
  user     User   @relation("UserEntries", fields: [userId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("AuthoredEntries", fields: [authorId], references: [id], onDelete: Cascade)

  sourcePackId    String?
  sourcePack      Pack?   @relation("PackEntries", fields: [sourcePackId], references: [id], onDelete: SetNull)
  upstreamEntryId String?
  citationCount   Int     @default(0)

  sourceRelationships EntryRelationship[]  @relation("SourceRelationship")
  targetRelationships EntryRelationship[]  @relation("TargetRelationship")
  revisionChanges     RevisionChange[]
  tuneMemoryLinks     AppMemoryLink[]      @relation("TuneMemoryEntry")
  appMemoryLinks      AppMemoryLink[]      @relation("AppMemoryEntry")
  accessGrants        AccessGrant[]
  receiptItems        ContextReceiptItem[]
  royaltiesGenerated  UserRoyalty[]
  // stars               Star[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collectionId, type, state])
  @@index([appMemoryId, type, state])
  @@index([authorId, sourcePackId])
  @@index([tags])
  @@index([expiresAt])
  @@map("entries")
}

model EntryRelationship {
  id String @id @default(cuid())

  sourceEntryId String
  sourceEntry   Entry  @relation("SourceRelationship", fields: [sourceEntryId], references: [id], onDelete: Cascade)

  targetEntryId String
  targetEntry   Entry  @relation("TargetRelationship", fields: [targetEntryId], references: [id], onDelete: Cascade)

  predicate  String
  confidence Float  @default(1.0)

  createdAt DateTime @default(now())

  @@unique([sourceEntryId, targetEntryId, predicate])
  @@map("entry_relationships")
}

model EntryTombstone {
  id              String  @id @default(cuid())
  originalEntryId String  @unique
  deletedByUserId String
  reason          String?
  cascaded        Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("entry_tombstones")
}

model AppMemory {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserAppMemories", fields: [userId], references: [id], onDelete: Cascade)

  clientId    String
  oauthClient OauthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  entries      Entry[]
  accessGrants AccessGrant[]
  usageLedgers AppMemoryUsageLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientId])
  @@map("app_memories")
}

model AppMemoryLink {
  id String @id @default(cuid())

  appEntryId  String
  tuneEntryId String
  syncMode    SyncMode @default(REVIEW)
  active      Boolean  @default(true)

  lastAppRevision  Int?
  lastTuneRevision Int?

  appEntry  Entry @relation("AppMemoryEntry", fields: [appEntryId], references: [id], onDelete: Cascade)
  tuneEntry Entry @relation("TuneMemoryEntry", fields: [tuneEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  lastSyncedAt DateTime?

  @@unique([appEntryId, tuneEntryId])
  @@map("app_memory_links")
}

model AppMemoryUsageLedger {
  id             String             @id @default(cuid())
  appMemoryId    String
  appMemory      AppMemory          @relation(fields: [appMemoryId], references: [id], onDelete: Cascade)
  clientId       String
  oauthClient    OauthClient        @relation("ClientAppMemoryLedger", fields: [clientId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?      @relation("OrgAppMemoryLedger", fields: [organizationId], references: [id], onDelete: SetNull)
  operation      AppMemoryOperation
  unitsProcessed Int                @default(1)
  costInCents    Float              @default(0.0)
  billedAt       DateTime?
  createdAt      DateTime           @default(now())

  @@index([clientId, createdAt])
  @@index([organizationId, billedAt])
  @@map("app_memory_usage_ledgers")
}

model AccessGrant {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserAccessGrants", fields: [userId], references: [id], onDelete: Cascade)

  clientId String

  oauthClient OauthClient @relation("GrantedToApp", fields: [clientId], references: [id], onDelete: Cascade)

  resourceType AccessResourceType
  resourceKey  String

  effect      AccessEffect       @default(ALLOW)
  permissions AccessPermission[]

  inherits Boolean @default(true)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  entryId String?
  entry   Entry?  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  appMemoryId String?
  appMemory   AppMemory? @relation(fields: [appMemoryId], references: [id], onDelete: Cascade)

  packId String?
  pack   Pack?   @relation(fields: [packId], references: [id], onDelete: Cascade)

  expiresAt DateTime?
  grantedAt DateTime  @default(now())

  @@unique([userId, clientId, resourceKey])
  @@index([userId, clientId, resourceType])
  @@map("access_grants")
}

model AccessRequest {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("UserAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  oauthClient OauthClient @relation("AppRequestsAccess", fields: [clientId], references: [id], onDelete: Cascade)

  purpose String
  status  AccessRequestStatus @default(PENDING)
  items   AccessRequestItem[]

  createdAt DateTime  @default(now())
  decidedAt DateTime?
  expiresAt DateTime?

  @@index([userId, status])
  @@map("access_requests")
}

model AccessRequestItem {
  id            String             @id @default(cuid())
  requestId     String
  accessRequest AccessRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resourceType  AccessResourceType
  resourceKey   String
  permissions   AccessPermission[]
  reason        String?

  @@map("access_request_items")
}

model ContextRequest {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("UserContextRequests", fields: [userId], references: [id], onDelete: Cascade)

  clientId String

  oauthClient OauthClient @relation("AppRequestsContext", fields: [clientId], references: [id], onDelete: Cascade)
  apiKeyId    String?
  // apiKey      DeveloperApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  packId      String?
  pack        Pack?       @relation(fields: [packId], references: [id], onDelete: SetNull)
  purpose     String
  query       String      @db.Text

  status ContextRequestStatus @default(PENDING)

  receipt     ContextReceipt?
  ledgerEntry ApiUsageLedger?

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([clientId, status, requestedAt])
  @@index([userId, requestedAt])
  @@index([apiKeyId, requestedAt])
  @@map("context_requests")
}

model ContextReceipt {
  id String @id @default(cuid())

  contextRequestId String @unique
  itemCount        Int    @default(0)

  contextRequest ContextRequest       @relation(fields: [contextRequestId], references: [id], onDelete: Cascade)
  items          ContextReceiptItem[]

  createdAt DateTime @default(now())

  @@map("context_receipts")
}

model ContextReceiptItem {
  id        String         @id @default(cuid())
  receiptId String
  receipt   ContextReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  entryId   String?
  entry     Entry?         @relation(fields: [entryId], references: [id], onDelete: Cascade)

  resourceKey    String?
  excerpt        String? @db.Text
  citationWeight Float   @default(1.0)

  createdAt DateTime @default(now())

  @@index([receiptId])
  @@index([entryId])
  @@map("context_receipt_items")
}

model ApiUsageLedger {
  id String @id @default(cuid())

  clientId    String?
  oauthClient OauthClient? @relation("AppUsageLedger", fields: [clientId], references: [id])

  contextRequestedId String?         @unique
  contextRequest     ContextRequest? @relation(fields: [contextRequestedId], references: [id])

  userId String?
  user   User?   @relation("UserUsageLedger", fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation("OrgUsageLedger", fields: [organizationId], references: [id], onDelete: SetNull)

  apiKeyId      String?
  // apiKey        DeveloperApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  packId        String?
  pack          Pack?            @relation(fields: [packId], references: [id], onDelete: SetNull)
  sponsorshipId String?
  sponsorship   PackSponsorship? @relation(fields: [sponsorshipId], references: [id], onDelete: SetNull)

  rawEntryCountN      Int   @default(0)
  effectiveEntryCount Float @default(0.0) // Neff(N) = N <= 500 ? N : 500 * (1 + ln(N / 500))
  appliedPFactor      Float @default(1.0) // Dynamic spend factor (P) = max(1, monthlySpendUSD)
  appliedMFactor      Float @default(1.0)

  tokensUsed Int @default(0)

  computeCostCents     Float @default(0.0)
  royaltyCostCents     Float @default(0.0)
  sponsorAbsorbedCents Float @default(0.0)
  totalCostCents       Float @default(0.0)

  royaltiesDistributed UserRoyalty[]

  billedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([packId, createdAt])
  @@map("api_usage_ledgers")
}

model UserRoyalty {
  id String @id @default(cuid())

  userId     String
  user       User             @relation("UserRoyalties", fields: [userId], references: [id])
  sourceType PayoutSourceType @default(CITATION_ROYALTY)
  entryId    String?
  entry      Entry?           @relation(fields: [entryId], references: [id])
  packId     String?
  pack       Pack?            @relation(fields: [packId], references: [id], onDelete: SetNull)
  ledgerId   String?
  ledger     ApiUsageLedger?  @relation(fields: [ledgerId], references: [id], onDelete: SetNull)
  bountyId   String?
  bounty     KnowledgeBounty? @relation(fields: [bountyId], references: [id], onDelete: SetNull)

  amountInCents  Float
  sourceClientId String

  payoutId String?
  payout   CreatorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  paidOutAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, paidOutAt])
  @@index([packId, createdAt])
  @@map("user_royalties")
}

model CreatorPayout {
  id String @id @default(cuid())
  userId String 
  user User @relation("UserPayouts", fields: [userId], references: [id], onDelete: Cascade)
  totalAmountCents Float
  currency Currency @default(USD)
  status PayoutStatus @default(PENDING)
  stripeTransferId String? @unique

  royalties UserRoyalty[]
  initiatedAt DateTime @default(now())
  completedAt DateTime?

  @@index([userId, status])
  @@map("creator_payouts")
}

model Path {
  id String @id @default(cuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  name                 String
  isDefault            Boolean   @default(false)
  isBlindContribution  Boolean   @default(false) // true for protected pack
  forkedFromRevisionId String?
  forkedFromRevision   Revision? @relation("PathFork", fields: [forkedFromRevisionId], references: [id], onDelete: SetNull)

  forkedPaths    Path[]     @relation("PathFork")
  revisions      Revision[] @relation("PathRevisions")
  headRevisionId String?
  headRevision   Revision?  @relation("PathHead", fields: [headRevisionId], onDelete: SetNull, references: [id])

  targetCombines Combine[] @relation("CombineTargetPath")
  sourceCombines Combine[] @relation("CombineSourcePath")
  // bountySubmissions BountySubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collectionId, name])
  @@map("paths")
}

model Revision {
  id String @id @default(cuid())

  pathId           String
  path             Path       @relation("PathRevisions", fields: [pathId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?      @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  number           Int
  message          String
  parentRevisionId String?
  parentRevision   Revision?  @relation("RevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions   Revision[] @relation("RevisionParent")

  forkedPaths Path[]           @relation("PathFork")
  headOfPaths Path[]           @relation("PathHead")
  changes     RevisionChange[]

  combineTarget Combine[] @relation("CombineTargetRevision")
  combineSource Combine[] @relation("CombineSourceRevision")
  combineBase   Combine[] @relation("CombineBaseRevision")
  combineResult Combine[] @relation("CombineResultRevision")
  releases      Release[]
  // bountySubmissions BountySubmission[]

  createdAt DateTime @default(now())

  @@unique([pathId, number])
  @@index([pathId, createdAt])
  @@map("revisions")
}

model RevisionChange {
  id String @id @default(cuid())

  revisionId String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  entryId String?
  entry   Entry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)

  operation RevisionOperation
  before    Json?
  after     Json?

  createdAt DateTime @default(now())

  @@index([revisionId])
  @@index([entryId])
  @@map("revision_changes")
}

model Combine {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  authorId    String?
  author      User?   @relation("CombineAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  targetPathId     String
  targetPath       Path              @relation("CombineTargetPath", fields: [targetPathId], references: [id], onDelete: Cascade)
  sourcePathId     String
  sourcePath       Path              @relation("CombineSourcePath", fields: [sourcePathId], references: [id], onDelete: Cascade)
  targetRevisionId String
  targetRevision   Revision          @relation("CombineTargetRevision", fields: [targetRevisionId], references: [id], onDelete: Cascade)
  sourceRevisionId String
  sourceRevision   Revision          @relation("CombineSourceRevision", fields: [sourceRevisionId], references: [id], onDelete: Cascade)
  baseRevisionId   String?
  baseRevision     Revision?         @relation("CombineBaseRevision", fields: [baseRevisionId], references: [id], onDelete: SetNull)
  status           CombineStatus     @default(PENDING)
  conflicts        CombineConflict[]
  resultRevisionId String?
  resultRevision   Revision?         @relation("CombineResultRevision", fields: [resultRevisionId], references: [id], onDelete: SetNull)
  // bountySubmissions BountySubmission[]

  createdAt   DateTime? @default(now())
  completedAt DateTime?

  @@index([targetPathId, status])
  @@index([sourcePathId])
  @@map("combines")
}

model CombineConflict {
  id        String  @id @default(cuid())
  combineId String
  combine   Combine @relation(fields: [combineId], references: [id], onDelete: Cascade)

  entryId     String?
  baseValue   Json?
  targetValue Json?
  sourceValue Json?

  resolution ConflictResolution @default(UNRESOLVED)

  resolvedValue Json?
  resolvedAt    DateTime?

  @@index([combineId])
  @@map("combine_conflicts")
}

model Pack {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation("UserPacks", fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  slug        String     @unique
  description String?
  visibility  Visibility @default(PRIVATE)

  accessMode       PackAccessMode       @default(OPEN)
  monetizationType PackMonetizationType @default(FREE)

  // Formula: (Neff(N) / (10 * P)) * $1 * M / 1000 request
  entryCount        Int   @default(0) // N
  mFactor           Float @default(1.0) // M in [0, infinity)
  oneTimePriceCents Int?

  platformFeePercent     Float @default(15.0)
  maintainerFeePercent   Float @default(20.0)
  contributorPoolPercent Float @default(60.0) // if platform (15%) + maintainer (20%) + contributor (60%) != 100%, leftover (5%) goes to chariry/donation/well-fare programmes like afforestation

  releases        Release[]
  imports         PackImport[]
  entries         Entry[]          @relation("PackEntries")
  // purchases PackPurchase[]
  // donations PackDonation[]
  // sponsorships PackSponsorship[]
  // bounties KnowledgeBounty[]
  // apiKeyScopes ApiKeyPackScope[]
  accessGrants    AccessGrant[]
  contextRequests ContextRequest[]
  usageLedgers    ApiUsageLedger[]
  royalties       UserRoyalty[]
  // stars Star[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, visibility])
  @@index([monetizationType, accessMode])
  @@map("packs")
}

model Release {
  id     String @id @default(cuid())
  packId String
  pack   Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)

  version          String
  sourceRevisionId String?
  sourceRevision   Revision? @relation(fields: [sourceRevisionId], references: [id], onDelete: SetNull)

  notes        String?      @db.Text
  manifest     Json
  entryCount   Int          @default(0)
  importedInto Collection[] @relation("ReleaseImportedCollections")
  imports      PackImport[]

  publishedAt DateTime @default(now())

  @@unique([packId, version])
  @@map("releases")
}

model PackImport {
  id     String @id @default(cuid())
  packId String
  pack   Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)

  releaseId        String
  installedRelease Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  targetCollectionId String
  targetCollection   Collection @relation(fields: [targetCollectionId], references: [id], onDelete: Cascade)

  syncMode SyncMode @default(REVIEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packId, targetCollectionId])
  @@map("pack_imports")
}

model PackPurchase {
  id                  String        @id @default(cuid())
  packId              String
  pack                Pack          @relation(fields: [packId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?         @relation("UserPackPurchases", fields: [userId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        Organization? @relation("OrgPackPurchases", fields: [organizationId], references: [id], onDelete: Cascade)
  pricePaidCents      Int
  platformFeeCents    Int // 15%
  creatorNetCents     Int // 80% // Remaining 5% goes to charity/donations/well-fare programmes like afforestation
  paidViaCreditsCents Float         @default(0.0)
  paymentId           String?
  payment             Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  purchasedComputeM   Float         @default(1.2)
  purchasedAt         DateTime      @default(now())

  @@unique([packId, userId])
  @@unique([packId, organizationId])
  @@map("pack_purchases")
}

model PackDonation {
  id               String   @id @default(cuid())
  packId           String
  pack             Pack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  donorUserId      String?
  donorUser        User?    @relation("UserDonations", fields: [donorUserId], references: [id], onDelete: SetNull)
  amountCents      Int
  platformFeeCents Int      @default(0)
  message          String?  @db.Text
  paymentId        String?  @unique
  payment          Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([packId])
  @@map("pack_donations")
}

model PackSponsorship {
  id                   String        @id @default(cuid())
  packId               String
  pack                 Pack          @relation(fields: [packId], references: [id], onDelete: Cascade)
  sponsorOrgId         String?
  sponsorOrg           Organization? @relation("OrgSponsorships", fields: [sponsorOrgId], references: [id], onDelete: SetNull)
  sponsorUserId        String?
  sponsorUser          User?         @relation("UserSponsorships", fields: [sponsorUserId], references: [id], onDelete: SetNull)
  totalBudgetCents     Float
  remainingBudgetCents Float
  sponsoredMFactor     Float         @default(0.0) // 0.0 <= M <= 1.0
  isActive             Boolean       @default(true)
  isVerifiedOfficial   Boolean       @default(true)

  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  usageLedgers ApiUsageLedger[]

  @@index([packId, isActive])
  @@map("pack_sponsorships")
}

model KnowledgeBounty {
  id           String @id @default(cuid())
  title        String
  description  String @db.Text
  requirements Json?

  creatorOrgId  String?
  creatorOrg    Organization? @relation("OrgBounties", fields: [creatorOrgId], references: [id], onDelete: SetNull)
  creatorUserId String?
  creatorUser   User?         @relation("UserBounties", fields: [creatorUserId], references: [id], onDelete: SetNull)
  targetPackId  String?
  targetPack    Pack?         @relation(fields: [targetPackId], references: [id], onDelete: SetNull)

  escrowAmountCents      Int
  platformFeeCent        Float @default(15.0)
  maintainerSharePercent Float @default(15.0)
  remainingPoolCents     Float
  targetEntryCount       Int   @default(100)

  status    BountyStatus @default(OPEN)
  paymentId String?      @unique
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // submissions BountySubmission[]
  royalties UserRoyalty[]

  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, targetPackId])
  @@map("knowledge_bounties")
}

model BountySubmission {
  id            String          @id @default(cuid())
  bountyId      String
  bounty        KnowledgeBounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   User            @relation("UserBountySubmissions", fields: [contributorId], references: [id], onDelete: Cascade)
  pathId        String?
  path          Path?           @relation(fields: [pathId], references: [id], onDelete: SetNull)
  revisionId    String?
  revision      Revision?       @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  combineId     String?
  combine       Combine?        @relation(fields: [combineId], references: [id], onDelete: SetNull)

  status               BountySubmissionStatus @default(PENDING)
  rewardAllocatedCents Float                  @default(0.0)
  reviewNotes          String?                @db.Text
  submittedAt          DateTime               @default(now())
  decidedAt            DateTime?

  @@index([bountyId, status])
  @@index([contributorId])
  @@map("bounty_submissions")
}

model Star {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId  String?
  pack    Pack?   @relation(fields: [packId], references: [id], onDelete: Cascade)
  entryId String?
  entry   Entry?  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, packId])
  @@unique([userId, entryId])
  @@map("stars")
}

model TuneApp {
  id String @id @default(cuid())

  publisherId String
  publisher   User   @relation("UserTuneApps", fields: [publisherId], references: [id], onDelete: Cascade)

  name          String
  slug          String                @unique
  description   String?               @db.Text
  manifesr      Json
  codeRef       String
  installations TuneAppInstallation[]
  publishedAt   DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("tune_apps")
}

model TuneAppInstallation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserTuneAppInstalls", fields: [userId], references: [id], onDelete: Cascade)

  tuneAppId String
  tuneApp   TuneApp @relation(fields: [tuneAppId], references: [id], onDelete: Cascade)

  permissionsGranted Json?
  installedAt        DateTime @default(now())

  @@map("tune_app_installations")
}

model RecallBlock {
  id          String @id @default(cuid())
  publisherId String
  publisher   User   @relation("UserRecallBlocks", fields: [publisherId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  version     String
  description String?   @db.Text
  manifest    Json
  codeRef     String
  reviewedAt  DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recall_blocks")
}

model BillingProfile {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  provider   PaymentProvider
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@map("billing_profiles")
}

model Plan {
  id              String          @id @default(cuid())
  name            String
  price           Int
  comparedAtPrice Int?
  interval        BillingInterval @default(MONTHLY)
  currency        Currency
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)

  // Access Layer
  intelligenceStorage String?
  sync                String?
  recall              String?
  versioning          String?
  sharing             String?
  features            Json?
  notIncludedFeatures Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments          Payment[]
  subscriptions     Subscription[]
  applicableCoupons Coupon[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

model Subscription {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  status     SubscriptionStatus @default(ACTIVE)
  providerId String?            @unique
  customerId String?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  providerTransactionId String?
  orderId               Int             @unique
  currency              Currency
  subTotal              Int
  discount              Int             @default(0)
  total                 Int
  couponUsageId         String?         @unique
  couponUsage           CouponUsage?    @relation(fields: [couponUsageId], references: [id])
  metadata              Json?
  paidAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  plan                  Plan?           @relation(fields: [planId], references: [id])
  planId                String?

  @@index([userId])
  @@map("payments")
}

model Coupon {
  id                 String                @id @default(cuid())
  code               String                @unique
  type               CouponType
  redeemptionType    CouponRedeemptionType
  status             CouponStatus          @default(ACTIVE)
  percentageDiscount Int?
  fixedDiscount      Int?
  maxUses            Int?
  usedCount          Int                   @default(0)
  perUserLimit       Int                   @default(1)
  applicablePlans    Plan[]
  startsAt           DateTime?
  expiresAt          DateTime?
  metadata           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  uses               CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  coupon          Coupon?  @relation(fields: [couponId], references: [id])
  couponId        String?
  payment         Payment?
  discountApplied Int?
  createdAt       DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_usages")
}
