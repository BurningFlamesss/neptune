model CollectionPurchase {
  id                  String        @id @default(cuid())
  collectionId        String
  collection          Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?         @relation("UserCollectionPurchases", fields: [userId], references: [id], onDelete: Cascade)
  organizationId      String?
  organization        Organization? @relation("OrgCollectionPurchases", fields: [organizationId], references: [id], onDelete: Cascade)
  pricePaidCents      Int
  platformFeeCents    Int // 15%
  creatorNetCents     Int // 80% // Remaining 5% goes to charity/donations/well-fare programmes like afforestation
  paidViaCreditsCents Float         @default(0.0)
  paymentId           String?       @unique
  payment             Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  purchasedComputeM   Float         @default(1.2)
  purchasedAt         DateTime      @default(now())

  @@unique([collectionId, userId])
  @@unique([collectionId, organizationId])
  @@map("collection_purchases")
}

model CollectionDonation {
  id               String     @id @default(cuid())
  collectionId     String
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  donorUserId      String?
  donorUser        User?      @relation("UserDonations", fields: [donorUserId], references: [id], onDelete: SetNull)
  amountCents      Int
  platformFeeCents Int        @default(0)
  message          String?    @db.Text
  paymentId        String?    @unique
  payment          Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt        DateTime   @default(now())

  @@index([collectionId])
  @@map("collection_donations")
}

model CollectionSponsorship {
  id                   String        @id @default(cuid())
  collectionId         String
  collection           Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sponsorOrgId         String?
  sponsorOrg           Organization? @relation("OrgSponsorships", fields: [sponsorOrgId], references: [id], onDelete: SetNull)
  sponsorUserId        String?
  sponsorUser          User?         @relation("UserSponsorships", fields: [sponsorUserId], references: [id], onDelete: SetNull)
  totalBudgetCents     Float
  remainingBudgetCents Float
  sponsoredMFactor     Float         @default(0.0) // 0.0 <= M <= 1.0
  isActive             Boolean       @default(true)
  isVerifiedOfficial   Boolean       @default(true)

  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  usageLedgers ApiUsageLedger[]

  @@index([collectionId, isActive])
  @@map("collection_sponsorships")
}

model KnowledgeBounty {
  id           String @id @default(cuid())
  title        String
  description  String @db.Text
  requirements Json?

  creatorOrgId       String?
  creatorOrg         Organization? @relation("OrgBounties", fields: [creatorOrgId], references: [id], onDelete: SetNull)
  creatorUserId      String?
  creatorUser        User?         @relation("UserBounties", fields: [creatorUserId], references: [id], onDelete: SetNull)
  targetCollectionId String?
  targetCollection   Collection?   @relation(fields: [targetCollectionId], references: [id], onDelete: SetNull)

  escrowAmountCents      Int
  platformFeeCent        Float @default(15.0)
  maintainerSharePercent Float @default(15.0)
  remainingPoolCents     Float
  targetEntryCount       Int   @default(100)

  status    BountyStatus @default(OPEN)
  paymentId String?      @unique
  payment   Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  combines  Combine[]
  royalties UserRoyalty[]

  expiresAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bountySubmissions BountySubmission[]

  @@index([status, targetCollectionId])
  @@map("knowledge_bounties")
}

model BountySubmission {
  id            String          @id @default(cuid())
  bountyId      String
  bounty        KnowledgeBounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   User            @relation("UserBountySubmissions", fields: [contributorId], references: [id], onDelete: Cascade)
  pathId        String?
  path          Path?           @relation(fields: [pathId], references: [id], onDelete: SetNull)
  revisionId    String?
  revision      Revision?       @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  combineId     String?
  combine       Combine?        @relation(fields: [combineId], references: [id], onDelete: SetNull)

  status               BountySubmissionStatus @default(PENDING)
  rewardAllocatedCents Float                  @default(0.0)
  reviewNotes          String?                @db.Text
  submittedAt          DateTime               @default(now())
  decidedAt            DateTime?

  @@index([bountyId, status])
  @@index([contributorId])
  @@map("bounty_submissions")
}

model Star {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entryId      String?
  entry        Entry?      @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, collectionId])
  @@unique([userId, entryId])
  @@map("stars")
}

model TuneApp {
  id String @id @default(cuid())

  publisherId String
  publisher   User   @relation("UserTuneApps", fields: [publisherId], references: [id], onDelete: Cascade)

  name          String
  slug          String                @unique
  description   String?               @db.Text
  manifesr      Json
  codeRef       String
  installations TuneAppInstallation[]
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tune_apps")
}

model TuneAppInstallation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserTuneAppInstalls", fields: [userId], references: [id], onDelete: Cascade)

  tuneAppId String
  tuneApp   TuneApp @relation(fields: [tuneAppId], references: [id], onDelete: Cascade)

  permissionsGranted Json?
  installedAt        DateTime @default(now())

  @@unique([userId, tuneAppId])
  @@map("tune_app_installations")
}

model RecallBlock {
  id          String @id @default(cuid())
  publisherId String
  publisher   User   @relation("UserRecallBlocks", fields: [publisherId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  version     String
  description String?   @db.Text
  manifest    Json
  codeRef     String
  reviewedAt  DateTime?
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publisherId, slug, version])
  @@map("recall_blocks")
}

model BillingProfile {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  provider   PaymentProvider
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@map("billing_profiles")
}

model Plan {
  id              String          @id @default(cuid())
  name            String
  price           Int
  comparedAtPrice Int?
  interval        BillingInterval @default(MONTHLY)
  currency        Currency
  isActive        Boolean         @default(true)
  sortOrder       Int             @default(0)

  basePFactor                    Float   @default(1.0) // Ring: 1, Ring+: 19, Magic Ring: 39
  monthlyComputeQuotaCents       Int     @default(600) // Ring: 600, Ring+: 2500, Magic Ring: 4500
  monthlyMarketplaceCreditsCents Int     @default(0) // Ring: 0, Ring+: 300, Magic Ring: 1000
  rateLimitPerMinute             Int     @default(10) // Ring: 10, Ring+: 120, Magic Ring: 600
  maxConnectedApps               Int?    @default(10) // Ring: 10, Ring+: 500, Magic Ring: null
  storageLimitBytes              BigInt? @default(10000000) // Ring: 10MB, 1GB, 15GB

  displayFeaturesIncluded    Json?
  displayFeaturesNotIncluded Json?

  payments          Payment[]
  subscriptions     Subscription[]
  applicableCoupons Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("plans")
}

model Subscription {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id])
  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  status     SubscriptionStatus @default(ACTIVE)
  providerId String?            @unique
  customerId String?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId        String?
  organization          Organization?   @relation("OrgPayments", fields: [organizationId], references: [id], onDelete: SetNull)
  purpose               PaymentPurpose  @default(SUBSCRIPTION)
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  providerTransactionId String?
  orderId               Int             @unique
  currency              Currency
  subTotal              Int
  discount              Int             @default(0)
  total                 Int

  collectionId        String?
  collection          Collection? @relation(fields: [collectionId], references: [id])
  platformFeeCents    Int
  creatorNetCents     Int
  paidViaCreditsCents Float
  message             String?

  couponUsageId String?      @unique
  couponUsage   CouponUsage? @relation(fields: [couponUsageId], references: [id])
  metadata      Json?
  paidAt        DateTime?
  planId        String?
  plan          Plan?        @relation(fields: [planId], references: [id])

  knowledgeBounty   KnowledgeBounty?
  royaliesGenerated UserRoyalty[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  collectionPurchase CollectionPurchase?
  collectionDonation CollectionDonation?
  collection         Collection?         @relation(fields: [collectionId], references: [id])

  @@index([userId, status])
  @@index([organizationId, status])
  @@index([collectionId, purpose])
  @@map("payments")
}

model Coupon {
  id                 String                @id @default(cuid())
  code               String                @unique
  type               CouponType
  redeemptionType    CouponRedeemptionType
  status             CouponStatus          @default(ACTIVE)
  percentageDiscount Int?
  fixedDiscount      Int?
  maxUses            Int?
  usedCount          Int                   @default(0)
  perUserLimit       Int                   @default(1)
  applicablePlans    Plan[]
  startsAt           DateTime?
  expiresAt          DateTime?
  metadata           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  uses               CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  coupon          Coupon?  @relation(fields: [couponId], references: [id])
  couponId        String?
  payment         Payment?
  discountApplied Int?
  createdAt       DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_usages")
}
